# Hope Studio configuration. Copy to .env and fill in what you have.
# Everything is optional: with nothing set, the agents draft from templates
# built on your knowledge base and nothing is sent or posted.

PORT=8787
# DATA_DIR=data
# Set to 1 behind HTTPS so session cookies are Secure.
# COOKIE_SECURE=1
# Load the sample items from the design canvases on first run (1) or start empty (0).
# SEED_SAMPLES=1
# Scheduler (Mondays 6:00 AM Central run, daily planner, publish queue every 5 minutes).
# SCHEDULER=1

# First-run passwords (otherwise random ones are printed once in the server log).
# LEILA_PASSWORD=
# CIERRA_PASSWORD=

# Claude: drafting, review, tagging. `npm install` adds the Anthropic SDK.
ANTHROPIC_API_KEY=
# HOPE_MODEL_DRAFT=claude-sonnet-5
# HOPE_MODEL_REVIEW=claude-sonnet-5
# HOPE_MODEL_FINAL=claude-opus-5-5
# HOPE_MODEL_TAG=claude-haiku-4-5-20251001

# Google OAuth for Team@hope-resuscitated.org (Gmail send + Google Docs export).
# Scopes: https://www.googleapis.com/auth/gmail.send, gmail.compose, gmail.readonly, documents
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Where to email when a scheduled job fails.
# ALERT_EMAIL=

# Meta (Facebook Page + Instagram Business). Publishing needs App Review for
# pages_manage_posts and instagram_content_publish.
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
# Public https address of this server, so Meta can fetch uploaded media.
PUBLIC_BASE_URL=
# META_GRAPH_VERSION=v21.0
# Send alt text with Instagram image posts (1) once your Graph API version supports it.
# META_IG_ALT_TEXT=0

# Grants.gov search is on by default; 0 turns it off.
# GRANTS_GOV=1

# Google Places for Prospect Scout.
GOOGLE_PLACES_API_KEY=
